# Database
DATABASE_URL="postgresql://username:password@localhost:5432/money_manager"

# Auth (required for signed auth_session cookies)
SESSION_SECRET="replace-with-64-char-random-hex"

# Encryption key for API Key Vault at rest (optional, defaults to SESSION_SECRET)
ENCRYPTION_KEY="money-manager-vault-key-32-chars-aes256"

# ─────────────────────────────────────────────────────────────────────────────
# MULTI-LLM BYOK CONFIGURATIONS (Optional — keys sync automatically to DB)
# ─────────────────────────────────────────────────────────────────────────────

# Google Gemini (Gemini 3.7 Flash, 2.5 Flash, 2.5 Pro, 2.0 Flash)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.7-flash"

# Anthropic Claude (Opus 4.8, Claude 3.7 Sonnet, Claude 3.5 Sonnet, Haiku)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-7-sonnet-20250219"

# OpenAI (GPT-5.6 Omni, GPT-5, o4 Reasoner, o3-mini, GPT-4o)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
OPENAI_BASE_URL="https://api.openai.com/v1"

# DeepSeek (DeepSeek V4, R1, V3)
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"

# Groq Cloud (Llama 3.3 70B Versatile, Mixtral)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# OpenRouter (Frontier Multi-Provider Routing)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="google/gemini-2.5-flash"

# Mistral AI (Mistral Large, Pixtral, Codestral)
MISTRAL_API_KEY=""
MISTRAL_MODEL="mistral-large-latest"

# xAI Grok (Grok 3, Grok 2)
XAI_API_KEY=""
GROK_MODEL="grok-2-latest"

# Alibaba Cloud Qwen (Qwen 3 Max, QwQ 32B, Qwen 2.5)
DASHSCOPE_API_KEY=""
QWEN_MODEL="qwen-3-max"

# Zhipu AI GLM (GLM-4 Plus, GLM-4V Plus Vision, GLM-4 Flash)
ZHIPU_API_KEY=""
GLM_MODEL="glm-4-plus"

# Moonshot AI Kimi (Kimi-K3, K2)
MOONSHOT_API_KEY=""
KIMI_MODEL="moonshot-v1-auto"

# Local Ollama (Zero-Cloud Private AI)
# OLLAMA_BASE_URL="http://localhost:11434"
# OLLAMA_MODEL="llama3.2"
