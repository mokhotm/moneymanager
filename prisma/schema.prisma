generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(cuid())
  username           String              @unique
  passwordHash       String
  email              String?             @unique
  role               String              @default("user")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  accounts           Account[]
  assets             Asset[]
  budgetItems        BudgetLineItem[]
  goals              Goal[]
  incomes            Income[]
  propertyDataConfig PropertyDataConfig?
  profile            UserProfile?
  agentMemories      UserAgentMemory[]
}

model UserProfile {
  id                 String            @id @default(cuid())
  userId             String            @unique
  firstName          String?
  lastName           String?
  fullName           String?
  jobTitle           String?
  employerName       String?
  idNumber           String?
  taxReference       String?
  preferredCurrency  String            @default("ZAR")
  avatarUrl          String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  subscriptionTierId String?
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userSubscription   UserSubscription?
}

model Account {
  id                  String          @id @default(cuid())
  name                String
  institution         String
  accountNumberMasked String?
  type                AccountType
  currency            String          @default("ZAR")
  openingBalance      Decimal         @default(0)
  openingBalanceDate  DateTime?
  isDebt              Boolean         @default(false)
  notes               String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  userId              String?
  isAsset             Boolean         @default(false)
  user                User?           @relation(fields: [userId], references: [id])
  assets              Asset[]
  bankConnection      BankConnection?
  debt                Debt?

  @@index([userId])
  @@index([type])
}

model Asset {
  id              String            @id @default(cuid())
  userId          String?
  accountId       String?
  name            String
  type            AssetType
  currentValue    Decimal
  valueConfidence BalanceConfidence @default(ESTIMATED)
  valueSource     String?
  linkedDebtId    String?
  lastValuedDate  DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  account         Account?          @relation(fields: [accountId], references: [id])
  user            User?             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([accountId])
}

model NetWorthSnapshot {
  id           String              @id @default(cuid())
  snapshotDate DateTime
  totalAssets  Decimal
  totalDebts   Decimal
  netWorth     Decimal
  generatedBy  SnapshotGeneratedBy @default(SCHEDULED)
  createdAt    DateTime            @default(now())

  @@index([snapshotDate])
}

model Debt {
  id                     String            @id @default(cuid())
  accountId              String            @unique
  currentBalance         Decimal
  balanceConfidence      BalanceConfidence @default(UNKNOWN)
  balanceSource          String?
  annualInterestRate     Decimal?
  interestRateConfidence BalanceConfidence @default(UNKNOWN)
  interestCompounding    String            @default("MONTHLY")
  minimumPayment         Decimal
  paymentMode            PaymentMode       @default(MINIMUM_ONLY)
  originationDate        DateTime?
  originalPrincipal      Decimal?
  originalTermMonths     Int?
  urgencyFlag            UrgencyFlag       @default(NONE)
  urgencyNote            String?
  includeInSnowball      Boolean           @default(true)
  priorityOverride       Int?
  status                 DebtStatus        @default(ACTIVE)
  settledAmount          Decimal?
  settledDate            DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  debtCategory           DebtCategory      @default(SHORT_TERM)
  account                Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  settlementEvents       SettlementEvent[]

  @@index([status])
  @@index([debtCategory])
}

model Goal {
  id                      String     @id @default(cuid())
  userId                  String?
  name                    String
  type                    GoalType
  targetAmount            Decimal?
  targetFormula           String?
  targetDate              DateTime?
  linkedAccountId         String?
  currentAmount           Decimal    @default(0)
  monthlyContribution     Decimal    @default(0)
  priority                Int        @default(1)
  status                  GoalStatus @default(ACTIVE)
  projectedCompletionDate DateTime?
  note                    String?
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt
  user                    User?      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

model Income {
  id                        String           @id @default(cuid())
  sourceName                String
  recurringAmount           Decimal
  recurringAmountConfidence IncomeConfidence @default(ESTIMATED)
  payDayOfMonth             Int              @default(25)
  lastConfirmedDate         DateTime?
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
  userId                    String?
  user                      User?            @relation(fields: [userId], references: [id])
  incomeEvents              IncomeEvent[]

  @@index([userId])
}

model IncomeEvent {
  id              String         @id @default(cuid())
  incomeId        String?
  description     String
  amount          Decimal
  dateReceived    DateTime
  recommendedUse  RecommendedUse @default(UNALLOCATED)
  applied         Boolean        @default(false)
  appliedToDebtId String?
  createdAt       DateTime       @default(now())
  appliedToGoalId String?
  income          Income?        @relation(fields: [incomeId], references: [id])
}

model BudgetLineItem {
  id         String            @id @default(cuid())
  category   BudgetCategory
  label      String
  amount     Decimal
  isComputed Boolean           @default(false)
  sourceRef  String?
  confidence BalanceConfidence @default(ESTIMATED)
  note       String?
  month      String
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  userId     String?
  user       User?             @relation(fields: [userId], references: [id])

  @@index([userId, month])
  @@index([category])
}

model SettlementEvent {
  id                         String   @id @default(cuid())
  debtId                     String
  description                String
  amount                     Decimal
  date                       DateTime
  resultingNewMinimumPayment Decimal?
  createdAt                  DateTime @default(now())
  debt                       Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
}

model Document {
  id                     String              @id @default(cuid())
  relatedEntityType      RelatedEntityType
  relatedEntityId        String
  documentType           DocumentType
  fileUrl                String
  periodStart            DateTime?
  periodEnd              DateTime?
  uploadedAt             DateTime            @default(now())
  parsed                 Boolean             @default(false)
  parsedData             Json?
  fileHash               String?
  parseStatus            ParseStatus         @default(PENDING)
  supersededByDocumentId String?
  embeddings             DocumentEmbedding[]

  @@index([documentType])
  @@index([relatedEntityId])
  @@index([uploadedAt])
}

model DocumentEmbedding {
  id            String   @id @default(cuid())
  documentId    String
  contentChunk  String
  embeddingJson Json
  metadataJson  Json?
  createdAt     DateTime @default(now())
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model AgentRecommendation {
  id          String               @id @default(cuid())
  agent       AgentType
  title       String
  description String
  rationale   String
  payload     Json
  status      RecommendationStatus @default(PENDING)
  createdAt   DateTime             @default(now())
  reviewedAt  DateTime?
}

model LLMProviderConfig {
  id               String                 @id @default(cuid())
  provider         LLMProvider
  displayName      String
  apiKeyEncrypted  String
  baseUrl          String?
  modelName        String
  supportsVision   Boolean                @default(false)
  status           LLMConfigStatus        @default(UNVERIFIED)
  lastValidatedAt  DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  agentAssignments AgentModelAssignment[]
}

model AgentModelAssignment {
  id                  String            @id @default(cuid())
  agent               AgentType         @unique
  llmProviderConfigId String
  isDefault           Boolean           @default(false)
  updatedAt           DateTime          @updatedAt
  llmProviderConfig   LLMProviderConfig @relation(fields: [llmProviderConfigId], references: [id], onDelete: Cascade)
}

model UserAgentMemory {
  id              String   @id @default(cuid())
  userId          String
  domain          String   // "GEO" | "DEBT" | "BUDGET" | "GOALS" | "DOCUMENT" | "PREFERENCE"
  key             String   // e.g. "SEASON AND SPAR" or "PRIMARY_SALARY_CYCLE"
  learnedPattern  String   // Detailed text of pattern
  resolvedValue   Json     // e.g. { cleanMerchant: "Seasons Sport and Spa", lat: -25.7028, lng: 27.8425, region: "North West" }
  confidence      Float    @default(1.0)
  source          String   @default("USER_CORRECTION") // "USER_CORRECTION" | "PIN_CALIBRATION" | "AI_REFLECTION" | "SYSTEM_AUDIT"
  usageCount      Int      @default(1)
  lastUsedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, domain, key])
  @@index([userId, domain])
}

model AuditLogEntry {
  id           String   @id @default(cuid())
  entityType   String
  entityId     String
  fieldChanged String
  oldValue     String?
  newValue     String?
  reason       String?
  changedAt    DateTime @default(now())
  changedBy    String   @default("user")
  actor        String   @default("USER")

  @@index([entityType, entityId])
  @@index([changedAt])
}

model AppSettings {
  id               String           @id @default("singleton")
  snowballStrategy SnowballStrategy @default(SNOWBALL)
  currency         String           @default("ZAR")
  updatedAt        DateTime         @updatedAt
}

model PropertyDataConfig {
  id                  String   @id @default(cuid())
  userId              String   @unique
  windeedUsername     String?
  windeedPasswordEnc  String?
  windeedStatus       String   @default("UNVERIFIED")
  lightstoneApiKeyEnc String?
  lightstoneStatus    String   @default("UNVERIFIED")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BankConnection {
  id                   String                      @id @default(cuid())
  accountId            String                      @unique
  providerType         BankConnectionProviderType
  providerName         String
  consentStatus        BankConnectionConsentStatus @default(ACTIVE)
  consentGrantedAt     DateTime                    @default(now())
  consentExpiresAt     DateTime?
  accessTokenEncrypted String
  lastSyncedAt         DateTime?
  syncFrequency        SyncFrequency               @default(ON_DEMAND)
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  account              Account                     @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model MoneyFlow {
  id                  String           @id @default(cuid())
  parentFlowId        String?
  originTransactionId String?
  sourceType          FlowEndpointType
  sourceRef           String?
  destinationType     FlowEndpointType
  destinationRef      String?
  amount              Decimal
  currentAmount       Decimal
  flowType            FlowType
  status              FlowStatus       @default(ACTIVE)
  confidence          FlowConfidence   @default(CONFIRMED)
  createdAt           DateTime         @default(now())
  parentFlow          MoneyFlow?       @relation("FlowChain", fields: [parentFlowId], references: [id])
  childFlows          MoneyFlow[]      @relation("FlowChain")

  @@index([parentFlowId])
  @@index([sourceRef])
  @@index([destinationRef])
  @@index([flowType])
}

model DebtPayoffPlan {
  id                 String                @id @default(cuid())
  createdDate        DateTime              @default(now())
  strategy           SnowballStrategy      @default(SNOWBALL)
  isActive           Boolean               @default(true)
  supersededByPlanId String?
  createdAt          DateTime              @default(now())
  supersededByPlan   DebtPayoffPlan?       @relation("PlanSupersession", fields: [supersededByPlanId], references: [id])
  supersedesPlans    DebtPayoffPlan[]      @relation("PlanSupersession")
  months             DebtPayoffPlanMonth[]
}

model DebtPayoffPlanMonth {
  id               String         @id @default(cuid())
  planId           String
  monthNumber      Int
  calendarDate     DateTime
  debtId           String
  projectedBalance Decimal
  projectedPayment Decimal
  plan             DebtPayoffPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, monthNumber])
  @@index([debtId])
}

model FinancialHealthScore {
  id                  String     @id @default(cuid())
  snapshotDate        DateTime   @default(now())
  score               Int
  tier                HealthTier @default(ROOKIE)
  contributingFactors Json
  badges              Json
  streakCount         Int        @default(0)
  createdAt           DateTime   @default(now())
}

model TransactionRule {
  id                       String   @id @default(cuid())
  matchType                String
  matchValue               String
  actionType               String
  actionValue              String
  createdFromTransactionId String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model DocumentChunk {
  id                    String   @id @default(cuid())
  documentId            String
  chunkText             String
  chunkIndex            Int
  embeddingJson         Json
  embeddingModelVersion String   @default("v1")
  createdAt             DateTime @default(now())
}

model SubscriptionTier {
  id            String             @id @default(cuid())
  name          String
  priceMonthly  Decimal            @default(0)
  priceAnnual   Decimal?
  entitlements  Json
  isActive      Boolean            @default(true)
  subscriptions UserSubscription[]
}

model UserSubscription {
  id                 String             @id @default(cuid())
  userProfileId      String             @unique
  tierId             String
  status             SubscriptionStatus @default(ACTIVE)
  billingPeriod      BillingPeriod      @default(MONTHLY)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  autoRenew          Boolean            @default(true)
  paymentMethodToken String?
  tier               SubscriptionTier   @relation(fields: [tierId], references: [id])
  userProfile        UserProfile        @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
}

model PaymentGatewayConfig {
  id                           String                 @id @default(cuid())
  provider                     PaymentGatewayProvider
  mode                         GatewayMode            @default(SANDBOX)
  merchantCredentialsEncrypted String
  supportsCards                Boolean                @default(true)
  supportsEft                  Boolean                @default(false)
  supportsRecurringBilling     Boolean                @default(true)
  settlementAccountId          String
  status                       GatewayConfigStatus    @default(ACTIVE)
  settlementAccount            SettlementAccount      @relation(fields: [settlementAccountId], references: [id])
}

model SettlementAccount {
  id                    String                 @id @default(cuid())
  institution           String
  accountNumberMasked   String
  accountType           String
  isPrimary             Boolean                @default(false)
  paymentGatewayConfigs PaymentGatewayConfig[]
}

model PendingPayment {
  id             String        @id @default(cuid())
  userId         String
  tierId         String
  amount         Decimal
  idempotencyKey String        @unique
  status         PaymentStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

enum AccountType {
  CURRENT
  CREDIT_CARD
  LOAN
  MUNICIPAL
  SERVICE_ACCOUNT
  EDUCATION
  INSURANCE
  SUBSCRIPTION
  SAVINGS
  INVESTMENT
  RETIREMENT
  PROPERTY
  CASH_WALLET
}

enum BalanceConfidence {
  CONFIRMED
  ESTIMATED
  UNKNOWN
}

enum PaymentMode {
  MINIMUM_ONLY
  FIXED_INSTALMENT
  FIXED_TERM_LOAN
}

enum UrgencyFlag {
  NONE
  SERVICE_INTERRUPTION_RISK
  LEGAL_ACTION_RISK
  CREDIT_BUREAU_RISK
}

enum DebtStatus {
  ACTIVE
  PAID_OFF
  SETTLED_BY_INSURANCE
  WRITTEN_OFF
}

enum DebtCategory {
  SHORT_TERM
  LONG_TERM
}

enum SnowballStrategy {
  SNOWBALL
  AVALANCHE
}

enum IncomeConfidence {
  CONFIRMED
  ESTIMATED
}

enum RecommendedUse {
  DEBT_PAYDOWN
  EMERGENCY_FUND
  UNALLOCATED
  GOAL_CONTRIBUTION
}

enum BudgetCategory {
  FIXED_HOUSEHOLD_OBLIGATIONS
  DEBT_ACCELERATION_PLAN
  GOAL_CONTRIBUTIONS
  FAMILY_AND_DISCRETIONARY
  ONE_OFF_UNEXPECTED
}

enum DocumentType {
  BANK_STATEMENT
  PAYSLIP
  INVOICE
  MUNICIPAL_BILL
  OTHER
  INVESTMENT_STATEMENT
  RECEIPT
  CREDIT_REPORT
}

enum RelatedEntityType {
  ACCOUNT
  DEBT
  INCOME
  ASSET
}

enum AssetType {
  PROPERTY
  VEHICLE
  INVESTMENT_PORTFOLIO
  RETIREMENT_FUND
  CASH
  OTHER
}

enum GoalType {
  EMERGENCY_FUND
  DEBT_FREE_BY_DATE
  HOUSE_DEPOSIT
  RETIREMENT_INVESTMENT
  EDUCATION_FUND
  MAJOR_PURCHASE
  CUSTOM
}

enum GoalStatus {
  ACTIVE
  PAUSED
  ACHIEVED
  ABANDONED
}

enum AgentType {
  DOCUMENT_AGENT
  BUDGET_AGENT
  DEBT_AGENT
  GOALS_AGENT
  COACH
}

enum RecommendationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ParseStatus {
  PENDING
  PARSED_AWAITING_REVIEW
  APPLIED
  REJECTED_DUPLICATE
  FAILED
}

enum SnapshotGeneratedBy {
  SCHEDULED
  MANUAL
  AGENT_TRIGGERED
}

enum LLMProvider {
  ANTHROPIC
  OPENAI
  GOOGLE
  AZURE_OPENAI
  CUSTOM
}

enum LLMConfigStatus {
  ACTIVE
  INVALID_KEY
  UNVERIFIED
  DISABLED
}

enum BankConnectionProviderType {
  DIRECT_BANK_API
  LICENSED_AGGREGATOR
}

enum BankConnectionConsentStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum SyncFrequency {
  DAILY
  ON_DEMAND
}

enum FlowType {
  INCOME
  TRANSFER
  INVESTMENT
  DEBT_PAYMENT
  CASH_WITHDRAWAL
  CASH_SPENDING
  ASSET_PURCHASE
  ASSET_SALE
  GOAL_CONTRIBUTION
  DIVIDEND
  INTEREST
  REFUND
  TAX
  FEE
  LOAN
  OTHER
}

enum FlowStatus {
  ACTIVE
  PARTIALLY_CONSUMED
  FULLY_CONSUMED
}

enum FlowEndpointType {
  ACCOUNT
  ASSET
  DEBT
  CASH_WALLET
  EXTERNAL
}

enum FlowConfidence {
  CONFIRMED
  AGENT_SUGGESTED
}

enum DriftStatus {
  AHEAD_OF_PLAN
  ON_TRACK
  BEHIND_PLAN
}

enum HealthTier {
  ROOKIE
  ENTHUSIAST
  COMPETITOR
  EXPERT
  ELITE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  EXPIRED
}

enum BillingPeriod {
  MONTHLY
  ANNUAL
}

enum PaymentGatewayProvider {
  PAYFAST
  PEACH_PAYMENTS
  OZOW
  PAYGATE
  PAYSTACK
  YOCO
  CUSTOM
}

enum GatewayMode {
  SANDBOX
  LIVE
}

enum GatewayConfigStatus {
  ACTIVE
  INVALID_CREDENTIALS
  DISABLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}
